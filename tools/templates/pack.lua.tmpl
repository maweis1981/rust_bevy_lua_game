-- __KEY__.lua — generated by `make new-game NAME=__KEY__`. Talks to the host ONLY
-- through the `game` bridge + GAME_KIT helpers, so it runs identically on
-- iOS / Android / web / TikTok. See tools/PACK_SPEC.md + docs/PLATFORM_BLUEPRINT.md.
--
-- This is a playable STUB: drag the orb, a score ticks up, tap-to-restart, back
-- button, a persistent best score, and juice on start — all inherited from KIT.
-- Replace `update` with your mechanic; the shell (juice/records/back) stays.
local function make___KEY__()
  local K = GAME_KIT
  local T = K.tracker()
  local hero, score, best, playing, back

  local function reset()
    T.clear()
    score, playing = 0, true
    best = K.meta.record.get("__KEY__", "best")
    local hw, hh = game.bounds()
    hero = T.sprite(0, -hh + 90, 44, 44, "orb")
    back = K.make_back(T, hw, hh)
    K.juice.pickup(0, -hh + 90)      -- a little "go!" pop
    -- readers for the headless test harness (tools/test_pong.lua style)
    DEBUG = { game = "__KEY__", back = back,
      score = function() return score end, alive = function() return playing end }
  end

  local function finish()
    playing = false
    if K.meta.record.submit("__KEY__", "best", math.floor(score), "max") then K.juice.success()
    else K.juice.fail() end
  end

  return {
    enter = function() reset() end,
    leave = function() T.clear() end,
    update = function(dt, hw, hh)
      if not playing then return end
      local x, y, down = game.pointer()
      if down and x then game.move_to(hero, K.clamp(x, -hw + 22, hw - 22), -hh + 90) end
      score = score + dt
      if score >= 30 then finish() end      -- TODO: your win/lose rule
      game.set_text(string.format("SCORE %d   BEST %d", math.floor(score), best))
    end,
    tap = function(x, y)
      if back and K.in_rect(back, x, y) then K.switch("menu"); return end
      if not playing then reset() end        -- tap to restart when finished
    end,
  }
end

-- Self-register — the menu builds itself from PACKS. tier "ai" = AI-generated.
PACKS = PACKS or {}
PACKS["__KEY__"] = { slot = __SLOT__, key = "__KEY__", label = "__LABEL__", short = "__LABEL__",
  icon = "orb", color = { 0.40, 0.62, 0.92 }, tier = "ai", make = make___KEY__ }
